{
  "name": "APC Daily Unanswered-Questions Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 2,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "2b2b2b2b-0001-4000-8000-000000000001",
      "name": "Every Day at 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8000/admin/unanswered",
        "options": {}
      },
      "id": "2b2b2b2b-0002-4000-8000-000000000002",
      "name": "Get Unanswered Questions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-gaps",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2b2b2b2b-0003-4000-8000-000000000003",
      "name": "Any New Gaps?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [280, 300]
    },
    {
      "parameters": {
        "notesInFlow": true,
        "notes": "Placeholder for the real digest send. Wire this to a Gmail, Outlook, or Slack node using your own credentials. Suggested message body (one email per day, not one per question): '{{ $json.count }} unanswered question(s) today, most-asked first: ' + a formatted list from $json.questions (each item has question, times_asked, last_asked). Left as a No-Op so the workflow is importable and runnable without requiring any external account."
      },
      "id": "2b2b2b2b-0004-4000-8000-000000000004",
      "name": "Send Digest (connect Email/Slack here)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [520, 180]
    },
    {
      "parameters": {
        "notesInFlow": true,
        "notes": "No unanswered questions since the last check — nothing to send. This is what keeps the digest quiet on ordinary days instead of emailing 'zero gaps found' every morning."
      },
      "id": "2b2b2b2b-0005-4000-8000-000000000005",
      "name": "Nothing To Report",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [520, 420]
    }
  ],
  "connections": {
    "Every Day at 8am": {
      "main": [
        [
          { "node": "Get Unanswered Questions", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get Unanswered Questions": {
      "main": [
        [
          { "node": "Any New Gaps?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Any New Gaps?": {
      "main": [
        [
          { "node": "Send Digest (connect Email/Slack here)", "type": "main", "index": 0 }
        ],
        [
          { "node": "Nothing To Report", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
